{
  "name": "eventide-local",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "build:benchmark": "tsc --noEmit && vite build --mode benchmark --outDir artifacts/v141/after-benchmark",
    "test:vnext": "playwright test --config playwright.v141.config.ts",
    "perf:compare": "node scripts/compare-v14.mjs",
    "perf:long-run": "node scripts/long-run-v14.mjs",
    "test:v12": "playwright test --config playwright.v141.config.ts",
    "perf:report": "node scripts/report-v14.mjs",
    "test:v13": "playwright test --config playwright.v141.config.ts",
    "test:v14": "playwright test --config playwright.v141.config.ts",
    "test:v141": "playwright test --config playwright.v141.config.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "@types/node": "^24.0.0"
  }
}
